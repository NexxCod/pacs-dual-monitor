{
  "manifest_version": 3,
  "name": "PACS Dual Monitor",
  "short_name": "PACS Dual Monitor",
  "description": "Abre el visor de Synapse ya ubicado en los dos monitores externos, con zoom y escala correctos para medir, y verifica que el estudio realmente abra (sin pantalla negra).",
  "version": "2.0.4",
  "minimum_chrome_version": "111",
  "author": "Marcelo Salinas Villagra",
  "permissions": [
    "system.display",
    "tabs",
    "webNavigation",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://sjdpacs.synapsetimed.cl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sjdpacs.synapsetimed.cl/*"
      ],
      "js": [
        "page-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://sjdpacs.synapsetimed.cl/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "PACS Dual Monitor — click o Ctrl+Shift+Y: reubicar el visor"
  },
  "commands": {
    "reposition-viewer": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Reubicar el visor PACS en los dos monitores"
    }
  }
}
